# ResultRipple local configuration. No secrets in this file.

# FalkorDB connection used by the backend.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=resultripple

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Frontend dev server target (consumed by Vite at build time).
VITE_API_BASE_URL=http://127.0.0.1:8000
