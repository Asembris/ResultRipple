# ResultRipple local configuration. No secrets in this file.

# FalkorDB connection used by the backend.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=resultripple

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Generated runtime state: staged candidates and immutable issued editions.
# Relative paths resolve against backend/.
ARTIFACT_ROOT=runtime/artifacts

# Signs the demo session cookie. Any deployment must override this with a real
# secret supplied through the environment, never through a committed file.
# SESSION_SECRET=

# The frontend calls the API same-origin through the dev proxy, so this stays
# relative. Set API_PROXY_TARGET if the API is not on port 8000.
VITE_API_BASE_URL=/api
