# ResultRipple local configuration. No secrets in this file.

# FalkorDB connection used by the backend.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=resultripple

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Generated runtime state: staged candidates and immutable issued editions.
# Relative paths resolve against backend/.
ARTIFACT_ROOT=runtime/artifacts

# "development" or "test" allow generated local credentials. Anything else is
# treated as a deployment and refuses to start without the two values below.
APP_ENV=development

# Signs the demo session cookie. A deployment must set this to a real secret of
# at least 32 characters, supplied through the environment, never committed.
# SESSION_SECRET=

# Server-side passcodes gating demo sign-in, as person-id=passcode pairs. Leave
# unset locally and the API generates throwaway values and logs them at startup.
# A deployment must provision real ones here. Never commit actual passcodes.
# DEMO_PASSCODES=person-ari=...,person-noor=...,person-sam=...,person-operator=...

# The frontend calls the API same-origin through the dev proxy, so this stays
# relative. Set API_PROXY_TARGET if the API is not on port 8000.
VITE_API_BASE_URL=/api

# -- The one NVIDIA-hosted model ---------------------------------------------
# Supplied through the environment only. This file holds no key. Either the
# repository-root .env or backend/.env is loaded, whichever exists, and real
# environment variables take precedence over both.
# NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# The hosted endpoint honours turning reasoning off, which roughly halves
# latency and reports zero reasoning tokens. Off is the frozen configuration:
# it reached the same typed intent inside the 25-second budget, where reasoning
# on measured 22 to 28 seconds. Set it to true to inspect the slower path.
NVIDIA_REASONING=false

# Bounded agent job budget: four model turns, six tool calls, 4096 completion
# tokens including reported reasoning, and 25 seconds from request through
# persisted candidates.
AGENT_MAX_MODEL_TURNS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_COMPLETION_TOKENS=4096
AGENT_DEADLINE_SECONDS=25
AGENT_MAX_CONCURRENT_JOBS=2
