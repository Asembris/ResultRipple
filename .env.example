# ResultRipple local configuration. No secrets in this file.

# FalkorDB connection used by the backend.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=resultripple

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Generated runtime state: staged candidates and immutable issued editions.
# Relative paths resolve against backend/.
ARTIFACT_ROOT=runtime/artifacts

# "development" or "test" allow generated local credentials. Anything else is
# treated as a deployment and refuses to start without the two values below.
APP_ENV=development

# Signs the demo session cookie. A deployment must set this to a real secret of
# at least 32 characters, supplied through the environment, never committed.
# SESSION_SECRET=

# Server-side passcodes gating demo sign-in, as person-id=passcode pairs. Leave
# unset locally and the API generates throwaway values and logs them at startup.
# A deployment must provision real ones here. Never commit actual passcodes.
# DEMO_PASSCODES=person-ari=...,person-noor=...,person-sam=...,person-operator=...

# The frontend calls the API same-origin through the dev proxy, so this stays
# relative. Set API_PROXY_TARGET if the API is not on port 8000.
VITE_API_BASE_URL=/api
